.env

# Data files (keep raw/large data out of version control)
data/*.csv
data/*.parquet
data/*.xlsx
!data/.gitkeep

# Models and artifacts (keep large weights out of version control)
models/*.pkl
models/*.joblib
models/*.bin
models/*.onnx
!models/.gitkeep

# IDEs
.vscode/
.idea/
